{%- comment -%}
  Card grid with an optional marker on each card. The marker style switches this
  between the numbered "how it works" layout and the icon-led "why us" layout,
  so one section covers both patterns from the legacy site.
{%- endcomment -%}

<div
  class="apex-grid-section apex-surface apex-surface--{{ section.settings.surface_style }} color-{{ section.settings.color_scheme }}"
  style="
    --apex-grid-pad-top: {{ section.settings.padding_top }}px;
    --apex-grid-pad-bottom: {{ section.settings.padding_bottom }}px;
    --apex-grid-columns: {{ section.settings.columns_desktop }};
    --apex-grid-columns-mobile: {{ section.settings.columns_mobile }};
  "
>
  <span class="apex-surface__grain" aria-hidden="true"></span>
  {%- if section.settings.show_grid -%}<span class="apex-surface__grid" aria-hidden="true"></span>{%- endif -%}

  <div class="page-width">
    {%- render 'apex-section-header',
      eyebrow: section.settings.eyebrow,
      title: section.settings.title,
      subtitle: section.settings.subtitle,
      alignment: section.settings.alignment
    -%}

    {%- if section.blocks.size > 0 -%}
      <ul class="apex-grid apex-grid--{{ section.settings.marker_style }} apex-grid--{{ section.settings.card_style }}" role="list">
        {%- for block in section.blocks -%}
          {%- assign reveal_index = forloop.index0 | modulo: 6 | plus: 1 -%}
          <li
            class="apex-card apex-reveal apex-reveal--{{ reveal_index }}{% if settings.animations_reveal_on_scroll %} scroll-trigger{% endif %}"
            {{ block.shopify_attributes }}
          >
            <span class="apex-card__sheen" aria-hidden="true"></span>
            {%- case section.settings.marker_style -%}
              {%- when 'number' -%}
                <span class="apex-card__number" aria-hidden="true">
                  {{- forloop.index | prepend: '0' | slice: -2, 2 -}}
                </span>
              {%- when 'icon' -%}
                <span class="apex-card__icon" aria-hidden="true">
                  {%- case block.settings.icon -%}
                    {%- when 'bolt' -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M13.5 2 4 13.5h6.5L10 22l9.5-11.5H13L13.5 2z"/>
                      </svg>
                    {%- when 'flame' -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 2s5 4.5 5 9a5 5 0 0 1-10 0c0-1.6.7-3 1.5-4C9 9.5 10 11 11 11c0-3 1-6 1-9z"/>
                        <path d="M12 22a7 7 0 0 0 7-7c0-1.3-.3-2.5-.8-3.6"/>
                      </svg>
                    {%- when 'target' -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1.4"/>
                      </svg>
                    {%- when 'clock' -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="9"/><path d="M12 6.8V12l3.4 2"/>
                      </svg>
                    {%- when 'shield' -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 2 4 5.5v6c0 5 3.4 9.2 8 10.5 4.6-1.3 8-5.5 8-10.5v-6L12 2z"/><path d="m9 12 2 2 4-4"/>
                      </svg>
                    {%- when 'palette' -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 2a10 10 0 1 0 0 20c1.1 0 2-.9 2-2 0-.5-.2-1-.5-1.3-.3-.4-.5-.8-.5-1.2 0-1.1.9-2 2-2h2.4A4.6 4.6 0 0 0 22 10.8C22 5.9 17.5 2 12 2z"/>
                        <circle cx="7.5" cy="11.5" r="1.2"/><circle cx="10.5" cy="7.5" r="1.2"/><circle cx="15.5" cy="8.5" r="1.2"/>
                      </svg>
                    {%- when 'sparkle' -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 2.5 14 9l6.5 2-6.5 2-2 6.5-2-6.5L3.5 11 10 9l2-6.5z"/>
                      </svg>
                    {%- else -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="9.2"/><path d="m8 12.3 2.7 2.7L16 9.7"/>
                      </svg>
                  {%- endcase -%}
                </span>
            {%- endcase -%}

            {%- if block.settings.title != blank -%}
              <h3 class="apex-card__title">{{ block.settings.title }}</h3>
            {%- endif -%}

            {%- if block.settings.text != blank -%}
              <div class="apex-card__text rte">{{ block.settings.text }}</div>
            {%- endif -%}

            {%- comment -%}
              One checklist item per line. newline_to_br is the only reliable way
              to split on newlines in Liquid.
            {%- endcomment -%}
            {%- if block.settings.checks != blank -%}
              {%- assign check_items = block.settings.checks | strip | newline_to_br | split: '<br />' -%}
              <ul class="apex-card__checks" role="list">
                {%- for item in check_items -%}
                  {%- assign check_text = item | strip -%}
                  {%- if check_text != blank -%}
                    <li class="apex-card__check">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <polyline points="20 6 9 17 4 12"/>
                      </svg>
                      <span>{{ check_text }}</span>
                    </li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            {%- endif -%}

            {%- if block.settings.link_label != blank -%}
              <a href="{{ block.settings.link | default: '#' }}" class="apex-card__link">
                {{ block.settings.link_label }}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M5 12h14"/><path d="m13 6 6 6-6 6"/>
                </svg>
              </a>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .apex-grid-section {
    padding-top: var(--apex-grid-pad-top, 72px);
    padding-bottom: var(--apex-grid-pad-bottom, 72px);
  }

  .apex-grid {
    display: grid;
    grid-template-columns: repeat(var(--apex-grid-columns, 4), minmax(0, 1fr));
    gap: clamp(18px, 2.2vw, 30px);
    margin: 0;
    padding: 0;
  }

  .apex-card {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .apex-grid--boxed .apex-card {
    padding: clamp(24px, 2.6vw, 38px);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-top: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: var(--apex-radius, 5px);
    background:
      linear-gradient(165deg, rgba(255, 255, 255, 0.055) 0%, rgba(255, 255, 255, 0.012) 42%, rgba(0, 0, 0, 0.12) 100%);
    box-shadow: var(--apex-elev-1);
    transition:
      border-color 0.4s ease,
      transform 0.45s var(--apex-ease-out),
      box-shadow 0.45s var(--apex-ease-out);
  }

  /* Light surfaces need the inverse treatment or the card vanishes. */
  .apex-surface--light .apex-grid--boxed .apex-card {
    border-color: rgba(0, 0, 0, 0.08);
    border-top-color: rgba(0, 0, 0, 0.06);
    background: linear-gradient(165deg, #FFFFFF 0%, #FAF9F7 100%);
  }

  .apex-grid--boxed .apex-card:hover {
    border-color: rgba(245, 131, 31, 0.42);
    transform: translateY(-6px);
    box-shadow: var(--apex-elev-2), var(--apex-glow-orange);
  }

  /* Slow diagonal light sweep — reads as brushed metal catching a lamp. */
  .apex-card__sheen {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    opacity: 0;
    background: linear-gradient(120deg, transparent 30%, rgba(245, 131, 31, 0.11) 50%, transparent 70%);
    transform: translateX(-40%);
    transition: opacity 0.5s ease, transform 0.9s var(--apex-ease-out);
  }

  .apex-card:hover .apex-card__sheen {
    opacity: 1;
    transform: translateX(40%);
  }

  .apex-card__number {
    font-family: var(--font-heading-family);
    font-size: clamp(38px, 4vw, 58px);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.03em;
    background: var(--apex-gradient);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .apex-card__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 54px;
    height: 54px;
    border: 1px solid rgba(245, 131, 31, 0.4);
    border-radius: var(--apex-radius, 5px);
    background: linear-gradient(160deg, rgba(245, 131, 31, 0.14) 0%, rgba(245, 131, 31, 0.02) 100%);
    color: var(--apex-orange);
    transition:
      background 0.4s ease,
      border-color 0.4s ease,
      transform 0.45s var(--apex-ease-out),
      box-shadow 0.45s ease;
  }

  .apex-card__icon svg { width: 26px; height: 26px; }

  .apex-card:hover .apex-card__icon {
    border-color: rgba(245, 131, 31, 0.75);
    background: linear-gradient(160deg, rgba(245, 131, 31, 0.26) 0%, rgba(245, 131, 31, 0.05) 100%);
    transform: translateY(-3px);
    box-shadow: 0 8px 22px rgba(245, 131, 31, 0.24);
  }

  .apex-card__title {
    margin: 20px 0 0;
    font-family: var(--font-heading-family);
    font-size: clamp(17px, 1.5vw, 21px);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  /* Hairline that grows on hover, tying the card to the button language. */
  .apex-card__title::after {
    content: '';
    display: block;
    width: 28px;
    height: 2px;
    margin: 14px 0 0;
    background: var(--apex-gradient);
    transform-origin: left center;
    transform: scaleX(0.6);
    transition: transform 0.45s var(--apex-ease-out);
  }

  .apex-card:hover .apex-card__title::after { transform: scaleX(1.5); }

  .apex-card__text {
    margin-top: 14px;
    font-size: clamp(14px, 1.05vw, 15.5px);
    line-height: 1.7;
    opacity: 0.72;
  }

  .apex-card__checks {
    margin: 16px 0 0;
    padding: 0;
    display: grid;
    gap: 9px;
  }

  .apex-card__check {
    display: flex;
    align-items: flex-start;
    gap: 9px;
    font-size: clamp(13px, 1vw, 14.5px);
    line-height: 1.45;
    opacity: 0.85;
  }

  .apex-card__check svg {
    flex-shrink: 0;
    width: 13px;
    height: 13px;
    margin-top: 4px;
    color: var(--apex-orange);
  }

  /* Pushes the link to the card foot so mixed-length cards align. */
  .apex-card__checks + .apex-card__link { margin-top: auto; padding-top: 18px; }

  .apex-card__link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 16px;
    font-family: var(--font-heading-family);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--apex-orange);
  }

  .apex-card__link svg {
    width: 15px;
    height: 15px;
    transition: transform 0.3s var(--apex-ease-out);
  }

  .apex-card__link:hover svg { transform: translateX(4px); }

  @media screen and (max-width: 989px) {
    .apex-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media screen and (max-width: 749px) {
    .apex-grid { grid-template-columns: repeat(var(--apex-grid-columns-mobile, 1), minmax(0, 1fr)); }
  }

  @media (prefers-reduced-motion: reduce) {
    .apex-grid--boxed .apex-card,
    .apex-card__icon,
    .apex-card__sheen,
    .apex-card__title::after,
    .apex-card__link svg { transition: none !important; }

    .apex-grid--boxed .apex-card:hover,
    .apex-card:hover .apex-card__icon { transform: none; }
    .apex-card:hover .apex-card__sheen { opacity: 0; }
    .apex-card__title::after { transform: scaleX(1); }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:apex.grid.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:apex.labels.eyebrow",
      "default": "Why Apex"
    },
    {
      "type": "text",
      "id": "title",
      "label": "t:apex.labels.title",
      "default": "Built different"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "t:apex.labels.subtitle"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "t:apex.labels.alignment",
      "default": "center",
      "options": [
        { "value": "left", "label": "t:apex.options.alignment.left" },
        { "value": "center", "label": "t:apex.options.alignment.center" }
      ]
    },
    {
      "type": "header",
      "content": "t:apex.grid.header__cards"
    },
    {
      "type": "select",
      "id": "marker_style",
      "label": "t:apex.labels.marker_style",
      "info": "t:apex.grid.marker_style_info",
      "default": "icon",
      "options": [
        { "value": "icon", "label": "t:apex.options.marker_style.icon" },
        { "value": "number", "label": "t:apex.options.marker_style.number" },
        { "value": "none", "label": "t:apex.options.marker_style.none" }
      ]
    },
    {
      "type": "select",
      "id": "card_style",
      "label": "t:apex.labels.card_style",
      "default": "boxed",
      "options": [
        { "value": "boxed", "label": "t:apex.options.card_style.boxed" },
        { "value": "plain", "label": "t:apex.options.card_style.plain" }
      ]
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "t:apex.labels.columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "t:apex.labels.columns_mobile",
      "default": "1",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ]
    },
    {
      "type": "header",
      "content": "t:apex.grid.header__layout"
    },
    {
      "type": "select",
      "id": "surface_style",
      "label": "t:apex.labels.surface_style",
      "default": "light",
      "options": [
        { "value": "dark", "label": "t:apex.options.surface_style.dark" },
        { "value": "deep", "label": "t:apex.options.surface_style.deep" },
        { "value": "light", "label": "t:apex.options.surface_style.light" }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_grid",
      "label": "t:apex.labels.show_grid",
      "info": "t:apex.labels.show_grid_info",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:apex.labels.color_scheme",
      "default": "scheme-2"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:apex.labels.padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:apex.labels.padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "t:apex.grid.blocks.card",
      "limit": 8,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "t:apex.labels.icon",
          "info": "t:apex.grid.icon_info",
          "default": "check",
          "options": [
            { "value": "check", "label": "t:apex.options.icon.check" },
            { "value": "shield", "label": "t:apex.options.icon.shield" },
            { "value": "bolt", "label": "t:apex.options.icon.bolt" },
            { "value": "flame", "label": "t:apex.options.icon.flame" },
            { "value": "target", "label": "t:apex.options.icon.target" },
            { "value": "clock", "label": "t:apex.options.icon.clock" },
            { "value": "palette", "label": "t:apex.options.icon.palette" },
            { "value": "sparkle", "label": "t:apex.options.icon.sparkle" }
          ]
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:apex.labels.title",
          "default": "Precision every time"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "t:apex.labels.text",
          "default": "<p>State-of-the-art laser and engraving equipment. Sub-millimeter accuracy on every job.</p>"
        },
        {
          "type": "textarea",
          "id": "checks",
          "label": "t:apex.labels.checks",
          "info": "t:apex.grid.checks_info"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "t:apex.labels.link_label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:apex.labels.link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:apex.grid.name",
      "blocks": [
        { "type": "card", "settings": { "icon": "palette", "title": "Coatings specialists", "text": "<p>We understand the unique requirements for specialty coatings. Cerakote, powder coat, and polished finishes.</p>" } },
        { "type": "card", "settings": { "icon": "target", "title": "Precision every time", "text": "<p>State-of-the-art laser and engraving equipment. Sub-millimeter accuracy on every job, whether it's one piece or a hundred.</p>" } },
        { "type": "card", "settings": { "icon": "clock", "title": "Fast turnaround", "text": "<p>Rush options available. Most standard jobs turned around in 3-5 business days without compromising quality.</p>" } },
        { "type": "card", "settings": { "icon": "shield", "title": "Quality guaranteed", "text": "<p>Sub-par work will never leave our shop. If your project isn't right, you don't pay.</p>" } }
      ]
    }
  ]
}
{% endschema %}
