{%- comment -%}
  Portfolio grid of finished work. Each tile carries a project title and the
  category of work, revealed over the image on hover and always visible on
  touch devices where there is no hover state.
{%- endcomment -%}

<div
  class="apex-gallery color-{{ section.settings.color_scheme }} gradient"
  style="
    --apex-gallery-pad-top: {{ section.settings.padding_top }}px;
    --apex-gallery-pad-bottom: {{ section.settings.padding_bottom }}px;
    --apex-gallery-columns: {{ section.settings.columns_desktop }};
    --apex-gallery-columns-mobile: {{ section.settings.columns_mobile }};
  "
>
  <div class="page-width">
    {%- render 'apex-section-header',
      eyebrow: section.settings.eyebrow,
      title: section.settings.title,
      subtitle: section.settings.subtitle,
      alignment: section.settings.alignment
    -%}

    {%- if section.blocks.size > 0 -%}
      <ul class="apex-gallery__grid apex-gallery__grid--{{ section.settings.image_ratio }}" role="list">
        {%- for block in section.blocks -%}
          {%- liquid
            assign tag = 'div'
            if block.settings.link != blank
              assign tag = 'a'
            endif
          -%}
          <li class="apex-gallery__item" {{ block.shopify_attributes }}>
            <{{ tag }}
              class="apex-gallery__tile"
              {% if tag == 'a' %}href="{{ block.settings.link }}"{% endif %}
            >
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 1200
                  | image_tag:
                    class: 'apex-gallery__image',
                    widths: '300, 450, 600, 900, 1200',
                    sizes: '(min-width: 990px) 30vw, (min-width: 750px) 45vw, 90vw',
                    loading: 'lazy',
                    alt: block.settings.title
                }}
              {%- else -%}
                {{ 'image' | placeholder_svg_tag: 'apex-gallery__image apex-gallery__image--placeholder' }}
              {%- endif -%}

              {%- if block.settings.title != blank or block.settings.category != blank -%}
                <div class="apex-gallery__caption">
                  {%- if block.settings.title != blank -%}
                    <p class="apex-gallery__caption-title">{{ block.settings.title }}</p>
                  {%- endif -%}
                  {%- if block.settings.category != blank -%}
                    <p class="apex-gallery__caption-category">{{ block.settings.category }}</p>
                  {%- endif -%}
                </div>
              {%- endif -%}
            </{{ tag }}>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if section.settings.button_label != blank -%}
      {%- comment -%}
        .apex-btn* is defined once in snippets/apex-variables.liquid so every
        section shares one button system. Theme Check cannot see across files.
      {%- endcomment -%}
      {% comment %}theme-check-disable ValidScopedCSSClass{% endcomment %}
      <div class="apex-gallery__actions">
        <a href="{{ section.settings.button_link | default: '#' }}" class="apex-btn apex-btn--outline">
          <span class="apex-btn__fill" aria-hidden="true"></span>
          <span class="apex-btn__label">{{ section.settings.button_label }}</span>
        </a>
      </div>
      {% comment %}theme-check-enable ValidScopedCSSClass{% endcomment %}
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .apex-gallery {
    padding-top: var(--apex-gallery-pad-top, 80px);
    padding-bottom: var(--apex-gallery-pad-bottom, 80px);
  }

  .apex-gallery__grid {
    display: grid;
    grid-template-columns: repeat(var(--apex-gallery-columns, 3), minmax(0, 1fr));
    gap: clamp(12px, 1.6vw, 22px);
    margin: 0;
    padding: 0;
  }

  .apex-gallery__tile {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: 4px;
    background: rgba(var(--color-foreground), 0.06);
    text-decoration: none;
    color: #fff;
  }

  .apex-gallery__grid--square .apex-gallery__tile { aspect-ratio: 1 / 1; }
  .apex-gallery__grid--portrait .apex-gallery__tile { aspect-ratio: 4 / 5; }
  .apex-gallery__grid--landscape .apex-gallery__tile { aspect-ratio: 3 / 2; }

  .apex-gallery__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s var(--apex-ease-out);
  }

  .apex-gallery__image--placeholder {
    background: rgba(var(--color-foreground), 0.06);
    fill: rgba(var(--color-foreground), 0.2);
  }

  .apex-gallery__tile:hover .apex-gallery__image { transform: scale(1.06); }

  .apex-gallery__caption {
    position: absolute;
    inset: auto 0 0 0;
    padding: clamp(14px, 1.6vw, 22px);
    background: linear-gradient(180deg, rgba(10, 9, 8, 0) 0%, rgba(10, 9, 8, 0.86) 62%);
  }

  .apex-gallery__caption-title {
    margin: 0;
    font-family: var(--font-heading-family);
    font-size: clamp(14px, 1.15vw, 17px);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .apex-gallery__caption-category {
    margin: 5px 0 0;
    font-size: clamp(11px, 0.9vw, 12.5px);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--apex-gold);
  }

  /* On pointer devices the caption stays tucked away until hover; on touch,
     where there is no hover, it is always readable. */
  @media (hover: hover) {
    .apex-gallery__caption {
      opacity: 0;
      transform: translateY(12px);
      transition:
        opacity 0.36s var(--apex-ease-out),
        transform 0.36s var(--apex-ease-out);
    }

    .apex-gallery__tile:hover .apex-gallery__caption,
    .apex-gallery__tile:focus-visible .apex-gallery__caption {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .apex-gallery__tile:focus-visible {
    outline: 2px solid var(--apex-gold);
    outline-offset: 3px;
  }

  .apex-gallery__actions {
    display: flex;
    justify-content: center;
    margin-top: clamp(28px, 3.4vw, 44px);
  }

  @media screen and (max-width: 989px) {
    .apex-gallery__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media screen and (max-width: 749px) {
    .apex-gallery__grid {
      grid-template-columns: repeat(var(--apex-gallery-columns-mobile, 2), minmax(0, 1fr));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .apex-gallery__image,
    .apex-gallery__caption { transition: none !important; }
    .apex-gallery__tile:hover .apex-gallery__image { transform: none; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:apex.gallery.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:apex.labels.eyebrow",
      "default": "Our work"
    },
    {
      "type": "text",
      "id": "title",
      "label": "t:apex.labels.title",
      "default": "Recent projects"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "t:apex.labels.subtitle",
      "default": "A sample of the craftsmanship we bring to every job."
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "t:apex.labels.alignment",
      "default": "center",
      "options": [
        { "value": "left", "label": "t:apex.options.alignment.left" },
        { "value": "center", "label": "t:apex.options.alignment.center" }
      ]
    },
    {
      "type": "header",
      "content": "t:apex.gallery.header__grid"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:apex.labels.image_ratio",
      "default": "square",
      "options": [
        { "value": "square", "label": "t:apex.options.image_ratio.square" },
        { "value": "portrait", "label": "t:apex.options.image_ratio.portrait" },
        { "value": "landscape", "label": "t:apex.options.image_ratio.landscape" }
      ]
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "t:apex.labels.columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "t:apex.labels.columns_mobile",
      "default": "2",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ]
    },
    {
      "type": "header",
      "content": "t:apex.gallery.header__button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:apex.labels.button_label",
      "default": "Full gallery"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:apex.labels.button_link"
    },
    {
      "type": "header",
      "content": "t:apex.gallery.header__layout"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:apex.labels.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:apex.labels.padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:apex.labels.padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "project",
      "name": "t:apex.gallery.blocks.project",
      "limit": 24,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:apex.labels.image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:apex.labels.title",
          "default": "Custom grips with officer's badge"
        },
        {
          "type": "text",
          "id": "category",
          "label": "t:apex.labels.category",
          "default": "Custom 1911 grips"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:apex.labels.link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:apex.gallery.name",
      "blocks": [
        { "type": "project", "settings": { "title": "Custom grips with officer's badge", "category": "Custom 1911 grips" } },
        { "type": "project", "settings": { "title": "Steampunk inspired engraving", "category": "Knife engraving" } },
        { "type": "project", "settings": { "title": "Custom ported slide and full Cerakote job", "category": "Slide porting / Cerakoting" } },
        { "type": "project", "settings": { "title": "Custom serialized tags", "category": "Custom artwork" } },
        { "type": "project", "settings": { "title": "Zippo lighter engraving", "category": "Custom engraving" } },
        { "type": "project", "settings": { "title": "Wolf 1911 grips", "category": "Custom 1911 grips" } }
      ]
    }
  ]
}
{% endschema %}
