{%- comment -%}
  Portfolio grid of finished work, rebuilt to match the original site's gallery:
  uniform 4:3 tiles, category filter tabs, a caption that rises on hover, and a
  click-to-enlarge lightbox that also plays the engraving clips.

  Every tile is the same size regardless of the source photograph's aspect —
  object-fit does the cropping so the grid stays on a strict rhythm.
{%- endcomment -%}

{%- liquid
  assign has_filters = false
  if section.settings.enable_filters
    assign cats = section.blocks | map: 'settings' | map: 'category' | uniq | compact
    if cats.size > 1
      assign has_filters = true
    endif
  endif
-%}

<div
  class="apex-gallery apex-surface apex-surface--{{ section.settings.surface_style }} color-{{ section.settings.color_scheme }}"
  style="
    --apex-gallery-pad-top: {{ section.settings.padding_top }}px;
    --apex-gallery-pad-bottom: {{ section.settings.padding_bottom }}px;
    --apex-gallery-columns: {{ section.settings.columns_desktop }};
    --apex-gallery-columns-mobile: {{ section.settings.columns_mobile }};
  "
>
  <span class="apex-surface__grain" aria-hidden="true"></span>
  {%- if section.settings.show_grid -%}<span class="apex-surface__grid" aria-hidden="true"></span>{%- endif -%}

  <div class="page-width">
    {%- render 'apex-section-header',
      eyebrow: section.settings.eyebrow,
      title: section.settings.title,
      subtitle: section.settings.subtitle,
      alignment: section.settings.alignment
    -%}

    {%- if has_filters -%}
      <div class="apex-gallery__filters" role="group" aria-label="{{ 'products.gallery.filter_label' | t }}">
        <button type="button" class="apex-gallery__filter is-active" data-filter="all" aria-pressed="true">
          {{ section.settings.filter_all_label | default: 'All work' }}
        </button>
        {%- for cat in cats -%}
          {%- if cat != blank -%}
            <button
              type="button"
              class="apex-gallery__filter"
              data-filter="{{ cat | handle }}"
              aria-pressed="false"
            >
              {{ cat }}
            </button>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <ul
        data-lightbox-group
        class="apex-gallery__grid apex-gallery__grid--{{ section.settings.image_ratio }}{% if section.settings.feature_first %} apex-gallery__grid--featured{% endif %}"
        role="list"
      >
        {%- for block in section.blocks -%}
          {%- liquid
            assign reveal_index = forloop.index0 | modulo: 6 | plus: 1

            assign is_video = false
            if block.settings.video_url != blank
              assign is_video = true
            endif

            assign full_src = ''
            if block.settings.image != blank
              assign full_src = block.settings.image | image_url: width: 2000
            endif
          -%}
          <li
            class="apex-gallery__item apex-reveal apex-reveal--{{ reveal_index }}{% if settings.animations_reveal_on_scroll %} scroll-trigger{% endif %}"
            data-cat="{{ block.settings.category | handle }}"
            {{ block.shopify_attributes }}
          >
            <button
              type="button"
              class="apex-gallery__tile"
              data-apex-lightbox
              data-type="{% if is_video %}video{% else %}image{% endif %}"
              data-full="{% if is_video %}{{ block.settings.video_url }}{% else %}{{ full_src }}{% endif %}"
              data-caption="{{ block.settings.title | escape }}"
              data-category="{{ block.settings.category | escape }}"
              aria-label="{{ block.settings.title | escape }}"
            >
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 1200
                  | image_tag:
                    class: 'apex-gallery__image',
                    widths: '300, 450, 600, 900, 1200',
                    sizes: '(min-width: 990px) 30vw, (min-width: 750px) 45vw, 90vw',
                    loading: 'lazy',
                    alt: block.settings.title
                }}
              {%- else -%}
                {{ 'image' | placeholder_svg_tag: 'apex-gallery__image apex-gallery__image--placeholder' }}
              {%- endif -%}

              {%- if is_video -%}
                <span class="apex-gallery__play" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="currentColor"><path d="M6 4l14 8-14 8z"/></svg>
                </span>
              {%- endif -%}

              <span class="apex-gallery__veil" aria-hidden="true"></span>

              {%- if block.settings.category != blank -%}
                <span class="apex-gallery__chip">{{ block.settings.category }}</span>
              {%- endif -%}

              {%- if block.settings.title != blank -%}
                <span class="apex-gallery__caption">
                  <span class="apex-gallery__caption-rule" aria-hidden="true"></span>
                  <span class="apex-gallery__caption-title">{{ block.settings.title }}</span>
                </span>
              {%- endif -%}
            </button>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if section.settings.button_label != blank -%}
      {%- comment -%}
        .apex-btn* is defined once in snippets/apex-variables.liquid so every
        section shares one button system. Theme Check cannot see across files.
      {%- endcomment -%}
      {% comment %}theme-check-disable ValidScopedCSSClass{% endcomment %}
      <div class="apex-gallery__actions">
        <a href="{{ section.settings.button_link | default: '#' }}" class="apex-btn apex-btn--outline">
          <span class="apex-btn__fill" aria-hidden="true"></span>
          <span class="apex-btn__label">{{ section.settings.button_label }}</span>
        </a>
      </div>
      {% comment %}theme-check-enable ValidScopedCSSClass{% endcomment %}
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .apex-gallery {
    padding-top: var(--apex-gallery-pad-top, 80px);
    padding-bottom: var(--apex-gallery-pad-bottom, 80px);
  }

  /* ---------- Filter tabs ---------- */

  .apex-gallery__filters {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 0 0 clamp(22px, 2.6vw, 34px);
  }

  .apex-gallery__filter {
    padding: 9px 18px;
    border: 1px solid rgba(var(--color-foreground), 0.22);
    border-radius: 999px;
    background: transparent;
    font-family: var(--font-heading-family);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(var(--color-foreground), 0.72);
    cursor: pointer;
    transition: color 0.25s ease, border-color 0.25s ease, background 0.25s ease;
  }

  .apex-gallery__filter:hover {
    border-color: var(--apex-orange);
    color: var(--apex-orange);
  }

  .apex-gallery__filter.is-active {
    border-color: transparent;
    background: var(--apex-gradient);
    color: #fff;
  }

  .apex-gallery__item.is-hidden { display: none; }

  /* ---------- Grid ---------- */

  .apex-gallery__grid {
    display: grid;
    grid-template-columns: repeat(var(--apex-gallery-columns, 4), minmax(0, 1fr));
    gap: clamp(12px, 1.4vw, 18px);
    /* Reset the list: without this the browser paints a marker beside each tile. */
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .apex-gallery__item { list-style: none; }
  .apex-gallery__item::marker { content: none; }

  .apex-gallery__tile {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: block;
    width: 100%;
    padding: 0;
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: var(--apex-radius, 5px);
    background: #1a1a1a;
    /* One ratio for every tile keeps the grid on a strict rhythm no matter what
       shape the original photograph is. */
    aspect-ratio: 4 / 3;
    cursor: zoom-in;
    text-align: left;
    appearance: none;
    transition: transform 0.4s var(--apex-ease-out), box-shadow 0.4s var(--apex-ease-out), border-color 0.4s ease;
  }

  .apex-gallery__grid--portrait .apex-gallery__tile { aspect-ratio: 3 / 4; }
  .apex-gallery__grid--square   .apex-gallery__tile { aspect-ratio: 1 / 1; }

  .apex-surface--light .apex-gallery__tile { border-color: rgba(0, 0, 0, 0.08); }

  .apex-gallery__tile:hover {
    border-color: rgba(245, 131, 31, 0.5);
    box-shadow: var(--apex-elev-2), var(--apex-glow-orange);
  }

  .apex-gallery__tile:focus-visible {
    outline: 2px solid var(--apex-gold);
    outline-offset: 3px;
  }

  .apex-gallery__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s var(--apex-ease-out);
  }

  .apex-gallery__tile:hover .apex-gallery__image { transform: scale(1.06); }

  .apex-gallery__play {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 3;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    margin: -26px 0 0 -26px;
    border-radius: 50%;
    background: rgba(245, 131, 31, 0.92);
    color: #fff;
    pointer-events: none;
    box-shadow: 0 2px 16px rgba(0, 0, 0, 0.5);
    transition: transform 0.35s var(--apex-ease-out);
  }

  .apex-gallery__play svg { width: 20px; height: 20px; margin-left: 3px; }
  .apex-gallery__tile:hover .apex-gallery__play { transform: scale(1.12); }

  .apex-gallery__veil {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.82) 0%, rgba(0, 0, 0, 0.15) 45%, transparent 70%);
    opacity: 0;
    transition: opacity 0.35s ease;
  }

  .apex-gallery__tile:hover .apex-gallery__veil { opacity: 1; }

  .apex-gallery__chip {
    position: absolute;
    top: 12px;
    left: 12px;
    z-index: 2;
    padding: 6px 11px;
    border-radius: 3px;
    background: rgba(10, 9, 8, 0.72);
    backdrop-filter: blur(4px);
    font-family: var(--font-heading-family);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--apex-gold);
  }

  .apex-gallery__caption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 2;
    display: block;
    padding: 16px;
    transform: translateY(8px);
    opacity: 0;
    transition: transform 0.35s var(--apex-ease-out), opacity 0.35s ease;
  }

  .apex-gallery__tile:hover .apex-gallery__caption {
    transform: translateY(0);
    opacity: 1;
  }

  .apex-gallery__caption-rule {
    display: block;
    width: 26px;
    height: 2px;
    margin-bottom: 8px;
    background: var(--apex-gradient);
  }

  .apex-gallery__caption-title {
    display: block;
    font-family: var(--font-heading-family);
    font-size: clamp(13px, 1.1vw, 15px);
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #fff;
  }

  /* Touch devices have no hover, so the caption is always legible there. */
  @media (hover: none) {
    .apex-gallery__veil,
    .apex-gallery__caption { opacity: 1; transform: none; }
  }

  .apex-gallery__actions {
    display: flex;
    justify-content: center;
    margin-top: clamp(26px, 3vw, 42px);
  }

  @media screen and (max-width: 989px) {
    .apex-gallery__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }

  @media screen and (max-width: 749px) {
    .apex-gallery__grid {
      grid-template-columns: repeat(var(--apex-gallery-columns-mobile, 2), minmax(0, 1fr));
    }
    .apex-gallery__filters { gap: 8px; }
    .apex-gallery__filter { padding: 8px 14px; font-size: 11px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .apex-gallery__tile,
    .apex-gallery__image,
    .apex-gallery__veil,
    .apex-gallery__caption { transition: none !important; }

    .apex-gallery__tile:hover { transform: none; }
    .apex-gallery__tile:hover .apex-gallery__image { transform: none; }
  }
{% endstylesheet %}

{% javascript %}
  // Category filter tabs. The lightbox itself is shared and lives in
  // assets/apex-lightbox.js, which every tile opts into via data-apex-lightbox.
  document.addEventListener('click', function (e) {
    var btn = e.target.closest && e.target.closest('.apex-gallery__filter');
    if (!btn) return;

    var wrap = btn.closest('.apex-gallery');
    var filter = btn.getAttribute('data-filter');

    wrap.querySelectorAll('.apex-gallery__filter').forEach(function (b) {
      var on = b === btn;
      b.classList.toggle('is-active', on);
      b.setAttribute('aria-pressed', on ? 'true' : 'false');
    });

    wrap.querySelectorAll('.apex-gallery__item').forEach(function (item) {
      item.classList.toggle('is-hidden', filter !== 'all' && item.getAttribute('data-cat') !== filter);
    });
  });
{% endjavascript %}

{% schema %}
{
  "name": "t:apex.gallery.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:apex.labels.eyebrow",
      "default": "Our work"
    },
    {
      "type": "text",
      "id": "title",
      "label": "t:apex.labels.title",
      "default": "Recent projects"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "t:apex.labels.subtitle"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "t:apex.labels.alignment",
      "default": "center",
      "options": [
        { "value": "left", "label": "t:apex.options.alignment.left" },
        { "value": "center", "label": "t:apex.options.alignment.center" }
      ]
    },
    {
      "type": "header",
      "content": "t:apex.gallery.header__grid"
    },
    {
      "type": "checkbox",
      "id": "enable_filters",
      "label": "t:apex.gallery.enable_filters",
      "info": "t:apex.gallery.enable_filters_info",
      "default": false
    },
    {
      "type": "text",
      "id": "filter_all_label",
      "label": "t:apex.gallery.filter_all_label",
      "default": "All work"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:apex.labels.image_ratio",
      "default": "landscape",
      "options": [
        { "value": "square", "label": "t:apex.options.image_ratio.square" },
        { "value": "portrait", "label": "t:apex.options.image_ratio.portrait" },
        { "value": "landscape", "label": "t:apex.options.image_ratio.landscape" }
      ]
    },
    {
      "type": "checkbox",
      "id": "feature_first",
      "label": "t:apex.labels.feature_first",
      "info": "t:apex.labels.feature_first_info",
      "default": false
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "t:apex.labels.columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "t:apex.labels.columns_mobile",
      "default": "2",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ]
    },
    {
      "type": "header",
      "content": "t:apex.gallery.header__button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:apex.labels.button_label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:apex.labels.button_link"
    },
    {
      "type": "header",
      "content": "t:apex.gallery.header__layout"
    },
    {
      "type": "select",
      "id": "surface_style",
      "label": "t:apex.labels.surface_style",
      "default": "dark",
      "options": [
        { "value": "dark", "label": "t:apex.options.surface_style.dark" },
        { "value": "deep", "label": "t:apex.options.surface_style.deep" },
        { "value": "light", "label": "t:apex.options.surface_style.light" }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_grid",
      "label": "t:apex.labels.show_grid",
      "info": "t:apex.labels.show_grid_info",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:apex.labels.color_scheme",
      "default": "scheme-4"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:apex.labels.padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:apex.labels.padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "project",
      "name": "t:apex.gallery.blocks.project",
      "limit": 50,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:apex.labels.image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:apex.labels.title",
          "default": "Custom engraving"
        },
        {
          "type": "text",
          "id": "category",
          "label": "t:apex.labels.category",
          "default": "Custom work"
        },
        {
          "type": "url",
          "id": "video_url",
          "label": "t:apex.gallery.video_url",
          "info": "t:apex.gallery.video_url_info"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:apex.gallery.name",
      "blocks": [
        { "type": "project" },
        { "type": "project" },
        { "type": "project" },
        { "type": "project" }
      ]
    }
  ]
}
{% endschema %}
