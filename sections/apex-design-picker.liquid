{%- comment -%}
  Reproduces the original site's product landing pages (PMAGs, Zippos, 1911
  grips): a hero with feature chips, a four-up info strip, then a "choose your
  design" grid where each card adds the parent product to the cart carrying the
  chosen design as a line-item property.

  Designs are not separate Shopify products, so one product powers the whole
  grid and the selection travels as a property the shop can read on the order.

  A design card can override that: pick its own product (for lines like the
  Zippo accessories, where each item has its own price) or force it to the
  quote button regardless of whether a product is set.
{%- endcomment -%}

{%- liquid
  assign chips = section.settings.chips | strip | newline_to_br | split: '<br />'
  assign info_blocks = section.blocks | where: 'type', 'info'
  assign design_blocks = section.blocks | where: 'type', 'design'

  assign product = section.settings.product
  assign variant_id = ''
  if product != blank
    assign variant_id = product.selected_or_first_available_variant.id
  endif

  assign notice_states = section.settings.notice_states | strip | newline_to_br | split: '<br />'
-%}

<div class="apex-picker apex-surface apex-surface--{{ section.settings.surface_style }} color-{{ section.settings.color_scheme }}">
  <span class="apex-surface__grain" aria-hidden="true"></span>

  {%- comment -%} ---------- Hero ---------- {%- endcomment -%}
  <div class="apex-picker__hero page-width">
    {%- if section.settings.eyebrow != blank -%}
      <p class="apex-picker__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}

    {%- if section.settings.title != blank -%}
      <h1 class="apex-picker__title">{{ section.settings.title }}</h1>
    {%- endif -%}

    {%- if section.settings.description != blank -%}
      <div class="apex-picker__desc rte">{{ section.settings.description }}</div>
    {%- endif -%}

    {%- if section.settings.chips != blank -%}
      <ul class="apex-picker__chips" role="list">
        {%- for chip in chips -%}
          {%- assign chip_text = chip | strip -%}
          {%- if chip_text != blank -%}
            <li class="apex-picker__chip">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="20 6 9 17 4 12"/>
              </svg>
              {{ chip_text }}
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>

  {%- comment -%} ---------- Info strip ---------- {%- endcomment -%}
  {%- if info_blocks.size > 0 -%}
    <div class="apex-picker__strip">
      <div class="page-width">
        <ul class="apex-picker__info" role="list">
          {%- for block in info_blocks -%}
            <li class="apex-picker__info-item" {{ block.shopify_attributes }}>
              <span class="apex-picker__info-icon" aria-hidden="true">
                {%- case block.settings.icon -%}
                  {%- when 'clock' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="12" cy="12" r="9"/><path d="M12 6.8V12l3.4 2"/>
                    </svg>
                  {%- when 'price' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M12 2v20"/><path d="M17 6.5c0-2-2.2-3-5-3s-5 .9-5 3 2.2 2.8 5 3.4 5 1.4 5 3.6-2.2 3-5 3-5-1-5-3"/>
                    </svg>
                  {%- when 'chat' -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M21 11.5a8.4 8.4 0 0 1-9 8.4 9 9 0 0 1-3.3-.6L3 21l1.8-5A8.3 8.3 0 0 1 12 3.1a8.4 8.4 0 0 1 9 8.4z"/>
                    </svg>
                  {%- else -%}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M12 2 4 5.5v6c0 5 3.4 9.2 8 10.5 4.6-1.3 8-5.5 8-10.5v-6L12 2z"/>
                    </svg>
                {%- endcase -%}
              </span>
              <span class="apex-picker__info-text">
                <strong>{{ block.settings.title }}</strong>
                <span>{{ block.settings.text }}</span>
              </span>
            </li>
          {%- endfor -%}
        </ul>
      </div>
    </div>
  {%- endif -%}

  {%- comment -%}
    ---------- Shipping restriction notice ----------
    Sits above the design grid so the customer reads it before choosing, not at
    checkout. Enforcement itself lives in the Shopify shipping profile plus the
    cart gate — see snippets/apex-shipping-gate.liquid.
  {%- endcomment -%}
  {%- if section.settings.show_notice and section.settings.notice_title != blank -%}
    <div class="apex-picker__notice-wrap page-width">
      <aside class="apex-picker__notice" role="note">
        <p class="apex-picker__notice-title">
          <span class="apex-picker__notice-mark" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M10.3 3.6 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.6a2 2 0 0 0-3.4 0z"/><path d="M12 9v4"/><path d="M12 17h.01"/>
            </svg>
          </span>
          {{ section.settings.notice_title }}
        </p>

        {%- if section.settings.notice_text != blank -%}
          <div class="apex-picker__notice-text rte">{{ section.settings.notice_text }}</div>
        {%- endif -%}

        {%- if notice_states.size > 0 -%}
          <ul class="apex-picker__notice-states" role="list">
            {%- for state in notice_states -%}
              {%- assign state_name = state | strip -%}
              {%- if state_name != blank -%}
                <li>{{ state_name }}</li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- if section.settings.notice_footnote != blank -%}
          <p class="apex-picker__notice-foot">{{ section.settings.notice_footnote }}</p>
        {%- endif -%}
      </aside>
    </div>
  {%- endif -%}

  {%- comment -%} ---------- Design grid ---------- {%- endcomment -%}
  {%- if design_blocks.size > 0 -%}
    <div class="apex-picker__designs page-width">
      {%- render 'apex-section-header',
        title: section.settings.grid_title,
        subtitle: section.settings.grid_subtitle,
        alignment: 'center'
      -%}

      <ul class="apex-picker__grid" role="list" data-lightbox-group>
        {%- for block in design_blocks -%}
          {%- liquid
            assign reveal_index = forloop.index0 | modulo: 6 | plus: 1
            assign full_src = ''
            if block.settings.image != blank
              assign full_src = block.settings.image | image_url: width: 2000
            endif

            # A card's own product wins over the section's; without either it
            # falls back to the section product. cta_mode 'quote' overrides
            # both, so a single card can stay quote-only in an add-to-cart grid.
            assign card_product = product
            assign card_variant = variant_id
            if block.settings.product != blank
              assign card_product = block.settings.product
              assign card_variant = card_product.selected_or_first_available_variant.id
            endif

            assign can_add = false
            if card_product != blank and card_variant != blank
              assign can_add = true
            endif
            if block.settings.cta_mode == 'quote'
              assign can_add = false
            endif

            # The live product price is the one the customer actually pays, so
            # it outranks the typed badge whenever a product resolves — whether
            # it came from this card or from the section. The badge only shows
            # for lines that have no product behind them yet.
            assign card_price = block.settings.price_label
            if card_product != blank and section.settings.use_product_price
              assign card_price = card_product.price | money
            endif
          -%}
          <li
            class="apex-picker__card apex-reveal apex-reveal--{{ reveal_index }}{% if settings.animations_reveal_on_scroll %} scroll-trigger{% endif %}"
            {{ block.shopify_attributes }}
          >
            <button
              type="button"
              class="apex-picker__media"
              data-apex-lightbox
              data-full="{{ full_src }}"
              data-caption="{{ block.settings.name | escape }}"
              data-category="{{ section.settings.design_category | escape }}"
              aria-label="{{ 'products.gallery.enlarge' | t: name: block.settings.name }}"
            >
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 1000
                  | image_tag:
                    class: 'apex-picker__image',
                    widths: '260, 400, 600, 800, 1000',
                    sizes: '(min-width: 990px) 24vw, (min-width: 750px) 45vw, 90vw',
                    loading: 'lazy',
                    alt: block.settings.name
                }}
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: 'apex-picker__image' }}
              {%- endif -%}
              <span class="apex-picker__zoom" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5M11 8v6M8 11h6"/>
                </svg>
              </span>
            </button>

            <div class="apex-picker__body">
              <div class="apex-picker__head">
                {%- if card_price != blank -%}
                  <span class="apex-picker__price">{{ card_price }}</span>
                {%- endif -%}
                <h3 class="apex-picker__name">{{ block.settings.name }}</h3>
              </div>

              {%- if section.settings.spec_line != blank -%}
                <p class="apex-picker__spec">{{ section.settings.spec_line }}</p>
              {%- endif -%}

              {%- if can_add -%}
                {%- form 'product', card_product, class: 'apex-picker__form', id: null -%}
                  <input type="hidden" name="id" value="{{ card_variant }}">
                  <input type="hidden" name="quantity" value="1">
                  <input
                    type="hidden"
                    name="properties[{{ section.settings.property_label | default: 'Design' }}]"
                    value="{{ block.settings.name | escape }}"
                  >
                  {% comment %}theme-check-disable ValidScopedCSSClass{% endcomment %}
                  <button type="submit" class="apex-btn apex-btn--primary apex-picker__add">
                    <span class="apex-btn__sheen" aria-hidden="true"></span>
                    <span class="apex-btn__label">
                      <span class="apex-btn__icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/>
                        </svg>
                      </span>
                      {{ section.settings.add_label | default: 'Add to cart' }}
                    </span>
                  </button>
                  {% comment %}theme-check-enable ValidScopedCSSClass{% endcomment %}
                {%- endform -%}
              {%- else -%}
                {% comment %}theme-check-disable ValidScopedCSSClass{% endcomment %}
                <a href="{{ block.settings.quote_link | default: section.settings.fallback_link | default: routes.root_url }}" class="apex-btn apex-btn--outline apex-picker__add">
                  <span class="apex-btn__fill" aria-hidden="true"></span>
                  <span class="apex-btn__label">{{ section.settings.fallback_label | default: 'Request a quote' }}</span>
                </a>
                {% comment %}theme-check-enable ValidScopedCSSClass{% endcomment %}
              {%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  {%- endif -%}
</div>

{% stylesheet %}
  .apex-picker { position: relative; }

  /* ---------- Hero ---------- */

  /* These blocks also carry .page-width, whose `padding: 0 Xrem` shorthand has
     the same specificity and lands later — it was silently zeroing the vertical
     padding, which is why the eyebrow sat flush against the nav. Qualifying with
     the parent outranks it; longhands keep .page-width's horizontal gutters. */
  .apex-picker .apex-picker__hero {
    padding-top: clamp(76px, 8.5vw, 128px);
    padding-bottom: clamp(32px, 4vw, 56px);
  }

  .apex-picker__eyebrow {
    margin: 0 0 12px;
    font-family: var(--font-heading-family);
    font-size: clamp(12px, 1vw, 14px);
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--apex-orange);
  }

  .apex-picker__title {
    margin: 0;
    font-family: var(--font-heading-family);
    font-size: clamp(32px, 5vw, 68px);
    font-weight: 800;
    line-height: 0.98;
    text-transform: uppercase;
  }

  .apex-picker__desc {
    max-width: 780px;
    margin-top: 18px;
    font-size: clamp(15px, 1.2vw, 17px);
    line-height: 1.75;
    opacity: 0.72;
  }

  .apex-picker__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: clamp(22px, 2.6vw, 34px) 0 clamp(16px, 2vw, 28px);
    padding: 0;
    list-style: none;
  }

  .apex-picker__chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 16px;
    border: 1px solid rgba(245, 131, 31, 0.35);
    border-radius: 3px;
    background: rgba(245, 131, 31, 0.09);
    font-family: var(--font-heading-family);
    font-size: clamp(11px, 0.9vw, 13px);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--apex-orange);
  }

  .apex-picker__chip svg { width: 12px; height: 12px; flex-shrink: 0; }

  /* ---------- Info strip ---------- */

  .apex-picker__strip {
    border-top: 1px solid var(--apex-hairline);
    border-bottom: 1px solid var(--apex-hairline);
    background: rgba(255, 255, 255, 0.02);
    padding: clamp(24px, 3vw, 36px) 0;
  }

  .apex-picker__info {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(18px, 2.4vw, 34px);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .apex-picker__info-item { display: flex; gap: 12px; align-items: flex-start; }
  .apex-picker__info-icon { flex-shrink: 0; color: var(--apex-orange); }
  .apex-picker__info-icon svg { width: 22px; height: 22px; display: block; }

  .apex-picker__info-text strong {
    display: block;
    font-family: var(--font-heading-family);
    font-size: clamp(13px, 1.1vw, 15px);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .apex-picker__info-text span {
    display: block;
    margin-top: 4px;
    font-size: clamp(13px, 1vw, 14.5px);
    line-height: 1.5;
    opacity: 0.7;
  }

  /* ---------- Shipping restriction notice ---------- */

  .apex-picker .apex-picker__notice-wrap { padding-top: clamp(36px, 4.5vw, 64px); }

  .apex-picker__notice {
    border: 1px solid rgba(245, 131, 31, 0.42);
    border-left-width: 4px;
    border-radius: var(--apex-radius-lg, 8px);
    background: rgba(245, 131, 31, 0.08);
    padding: clamp(18px, 2.4vw, 28px) clamp(18px, 2.6vw, 32px);
  }

  .apex-picker__notice-title {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0;
    font-family: var(--font-heading-family);
    font-size: clamp(14px, 1.3vw, 17px);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--apex-orange);
  }

  .apex-picker__notice-mark { display: inline-flex; flex-shrink: 0; }
  .apex-picker__notice-mark svg { width: 20px; height: 20px; display: block; }

  .apex-picker__notice-text {
    margin-top: 10px;
    max-width: 78ch;
    font-size: clamp(13.5px, 1.05vw, 15px);
    line-height: 1.65;
    opacity: 0.78;
  }

  .apex-picker__notice-states {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 6px 18px;
    margin: 14px 0 0;
    padding: 0;
    list-style: none;
  }

  .apex-picker__notice-states li {
    position: relative;
    padding-left: 16px;
    font-size: clamp(13px, 1vw, 14.5px);
    line-height: 1.5;
  }

  .apex-picker__notice-states li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--apex-orange);
  }

  .apex-picker__notice-foot {
    margin: 14px 0 0;
    font-size: clamp(12px, 0.95vw, 13.5px);
    line-height: 1.6;
    opacity: 0.62;
  }

  /* ---------- Design grid ---------- */

  /* Extra top pad so "Choose your design" is not glued to the rule above it. */
  .apex-picker .apex-picker__designs {
    padding-top: clamp(72px, 8vw, 116px);
    padding-bottom: clamp(48px, 6vw, 84px);
  }

  .apex-picker__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(14px, 1.8vw, 24px);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .apex-picker__card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--apex-radius-lg, 8px);
    background: linear-gradient(168deg, rgba(255, 255, 255, 0.05) 0%, rgba(0, 0, 0, 0.16) 100%);
    list-style: none;
    transition: border-color 0.35s ease, transform 0.4s var(--apex-ease-out), box-shadow 0.4s var(--apex-ease-out);
  }

  .apex-surface--light .apex-picker__card {
    border-color: rgba(0, 0, 0, 0.09);
    background: #fff;
  }

  .apex-picker__card:hover {
    border-color: rgba(245, 131, 31, 0.45);
    transform: translateY(-4px);
    box-shadow: var(--apex-elev-2);
  }

  .apex-picker__media {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: #fff;
    /* One ratio for every card so the grid never goes ragged. */
    aspect-ratio: 1 / 1;
    cursor: zoom-in;
    appearance: none;
    overflow: hidden;
  }

  .apex-picker__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s var(--apex-ease-out);
  }

  .apex-picker__media:hover .apex-picker__image { transform: scale(1.05); }

  .apex-picker__zoom {
    position: absolute;
    right: 10px;
    bottom: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: rgba(10, 9, 8, 0.66);
    color: #fff;
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 0.3s ease, transform 0.3s var(--apex-ease-out);
    pointer-events: none;
  }

  .apex-picker__zoom svg { width: 17px; height: 17px; }

  .apex-picker__media:hover .apex-picker__zoom,
  .apex-picker__media:focus-visible .apex-picker__zoom { opacity: 1; transform: translateY(0); }

  .apex-picker__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: clamp(14px, 1.6vw, 20px);
  }

  /* Price sits above the name, not beside it, so it reads as the headline
     number rather than a badge competing with the title. */
  .apex-picker__head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
  }

  .apex-picker__name {
    margin: 0;
    font-family: var(--font-heading-family);
    font-size: clamp(14px, 1.2vw, 17px);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .apex-picker__price {
    flex-shrink: 0;
    padding: 5px 9px;
    border-radius: 3px;
    background: rgba(245, 131, 31, 0.16);
    font-family: var(--font-heading-family);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--apex-orange);
  }

  .apex-picker__spec {
    margin: 10px 0 0;
    font-size: clamp(12px, 0.95vw, 13.5px);
    line-height: 1.55;
    opacity: 0.65;
  }

  .apex-picker__form { margin: auto 0 0; padding-top: 14px; }

  .apex-picker__add {
    width: 100%;
    min-height: 48px;
    margin-top: auto;
  }

  @media screen and (max-width: 989px) {
    .apex-picker__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .apex-picker__info { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media screen and (max-width: 749px) {
    .apex-picker__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .apex-picker__info { grid-template-columns: 1fr; }
  }

  @media (prefers-reduced-motion: reduce) {
    .apex-picker__card,
    .apex-picker__image,
    .apex-picker__zoom { transition: none !important; }
    .apex-picker__card:hover { transform: none; }
    .apex-picker__media:hover .apex-picker__image { transform: none; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:apex.picker.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:apex.labels.eyebrow",
      "default": "Genuine Magpul PMAGs"
    },
    {
      "type": "text",
      "id": "title",
      "label": "t:apex.labels.title",
      "default": "Custom PMAG engraving"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "t:apex.labels.text"
    },
    {
      "type": "textarea",
      "id": "chips",
      "label": "t:apex.picker.chips",
      "info": "t:apex.picker.chips_info"
    },
    {
      "type": "header",
      "content": "t:apex.picker.header__grid"
    },
    {
      "type": "text",
      "id": "grid_title",
      "label": "t:apex.labels.title",
      "default": "Choose your design"
    },
    {
      "type": "textarea",
      "id": "grid_subtitle",
      "label": "t:apex.labels.subtitle"
    },
    {
      "type": "product",
      "id": "product",
      "label": "t:apex.picker.product",
      "info": "t:apex.picker.product_info"
    },
    {
      "type": "text",
      "id": "property_label",
      "label": "t:apex.picker.property_label",
      "default": "Design"
    },
    {
      "type": "text",
      "id": "design_category",
      "label": "t:apex.labels.category",
      "default": "Design"
