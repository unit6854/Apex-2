{%- comment -%}
  Visible FAQ: a list of question blocks rendered as an accordion, plus
  FAQPage structured data built from the same blocks.

  The structured data is emitted here, not in snippets/seo-schema.liquid, on
  purpose: Google's policy only allows FAQPage markup for questions a visitor
  can actually read on the page, so the markup and the markup's source must be
  the same list. Delete a block and its schema entry goes with it.

  Answers are rich text so they can hold a link (to the quote page, say); the
  schema copy of each answer is stripped to plain text.
{%- endcomment -%}

{%- liquid
  assign faq_blocks = section.blocks | where: 'type', 'question'
-%}

<div
  class="apex-faq apex-surface apex-surface--{{ section.settings.surface_style }} color-{{ section.settings.color_scheme }}"
  style="--apex-faq-pad-top: {{ section.settings.padding_top }}px; --apex-faq-pad-bottom: {{ section.settings.padding_bottom }}px;"
>
  <span class="apex-surface__grain" aria-hidden="true"></span>
  {%- if section.settings.show_grid -%}<span class="apex-surface__grid" aria-hidden="true"></span>{%- endif -%}

  <div class="apex-faq__inner page-width">
    {%- render 'apex-section-header',
      eyebrow: section.settings.eyebrow,
      title: section.settings.title,
      subtitle: section.settings.subtitle,
      alignment: 'center',
      heading_tag: section.settings.heading_tag
    -%}

    {%- if faq_blocks.size > 0 -%}
      <div class="apex-faq__list">
        {%- for block in faq_blocks -%}
          {%- assign reveal_index = forloop.index0 | modulo: 6 | plus: 1 -%}
          <details
            class="apex-faq__item apex-reveal apex-reveal--{{ reveal_index }}{% if settings.animations_reveal_on_scroll %} scroll-trigger{% endif %}"
            {% if forloop.first and section.settings.open_first %}open{% endif %}
            {{ block.shopify_attributes }}
          >
            <summary class="apex-faq__question">
              <h3 class="apex-faq__question-text">{{ block.settings.question }}</h3>
              <span class="apex-faq__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 5v14M5 12h14"/>
                </svg>
              </span>
            </summary>
            <div class="apex-faq__answer rte">{{ block.settings.answer }}</div>
          </details>
        {%- endfor -%}
      </div>

      {%- if section.settings.footnote != blank -%}
        <p class="apex-faq__footnote">{{ section.settings.footnote }}</p>
      {%- endif -%}

      <script type="application/ld+json">
        {
          "@context": "https://schema.org",
          "@type": "FAQPage",
          "mainEntity": [
            {%- for block in faq_blocks -%}
              {
                "@type": "Question",
                "name": {{ block.settings.question | strip_html | strip | json }},
                "acceptedAnswer": {
                  "@type": "Answer",
                  "text": {{ block.settings.answer | strip_html | strip_newlines | strip | json }}
                }
              }{%- unless forloop.last -%},{%- endunless -%}
            {%- endfor -%}
          ]
        }
      </script>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .apex-faq.apex-surface { position: relative; overflow: clip; }

  .apex-faq .apex-faq__inner {
    padding-top: var(--apex-faq-pad-top, 88px);
    padding-bottom: var(--apex-faq-pad-bottom, 88px);
  }

  .apex-faq__list {
    max-width: 860px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .apex-faq__item {
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--apex-radius-lg, 8px);
    background: var(--apex-graphite, #26272C);
    box-shadow: var(--apex-elev-1);
    transition: border-color 0.25s ease;
  }

  .apex-surface--light .apex-faq__item { border-color: rgba(0, 0, 0, 0.1); background: #fff; }

  .apex-faq__item[open],
  .apex-faq__item:hover { border-color: rgba(245, 131, 31, 0.45); }

  .apex-faq__question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: clamp(16px, 1.8vw, 20px) clamp(16px, 2vw, 24px);
    cursor: pointer;
    list-style: none;
  }

  .apex-faq__question::-webkit-details-marker { display: none; }

  .apex-faq__question-text {
    margin: 0;
    font-family: var(--font-heading-family);
    font-size: clamp(16px, 1.4vw, 19px);
    font-weight: 700;
    letter-spacing: 0.04em;
    line-height: 1.25;
    text-transform: uppercase;
  }

  .apex-faq__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: rgba(245, 131, 31, 0.16);
    color: var(--apex-orange);
    transition: transform 0.35s var(--apex-ease-out), background 0.25s ease;
  }

  .apex-faq__icon svg { width: 16px; height: 16px; }

  .apex-faq__item[open] .apex-faq__icon { transform: rotate(45deg); background: var(--apex-gradient); color: #fff; }

  .apex-faq__question:focus-visible { outline: 2px solid var(--apex-gold); outline-offset: -4px; border-radius: var(--apex-radius-lg, 8px); }

  .apex-faq__answer {
    padding: 0 clamp(16px, 2vw, 24px) clamp(18px, 2vw, 24px);
    max-width: 72ch;
    font-size: clamp(14.5px, 1.1vw, 16px);
    line-height: 1.7;
    opacity: 0.8;
  }

  .apex-faq__answer p { margin: 0 0 0.8em; }
  .apex-faq__answer p:last-child { margin-bottom: 0; }
  .apex-faq__answer a { color: var(--apex-orange); text-underline-offset: 3px; }

  .apex-faq__footnote {
    max-width: 860px;
    margin: clamp(20px, 2.4vw, 30px) auto 0;
    font-size: 13.5px;
    line-height: 1.6;
    text-align: center;
    opacity: 0.6;
  }

  @media (prefers-reduced-motion: reduce) {
    .apex-faq__icon { transition: none; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:apex.faq.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:apex.labels.eyebrow",
      "default": "Good to know"
    },
    {
      "type": "text",
      "id": "title",
      "label": "t:apex.labels.title",
      "default": "Frequently asked questions"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "t:apex.labels.heading_tag",
      "info": "t:apex.labels.heading_tag_info",
      "default": "h2",
      "options": [
        { "value": "h1", "label": "t:apex.options.heading_tag.h1" },
        { "value": "h2", "label": "t:apex.options.heading_tag.h2" }
      ]
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "t:apex.labels.subtitle"
    },
    {
      "type": "checkbox",
      "id": "open_first",
      "label": "t:apex.faq.open_first",
      "default": true
    },
    {
      "type": "textarea",
      "id": "footnote",
      "label": "t:apex.faq.footnote"
    },
    {
      "type": "header",
      "content": "t:apex.gallery.header__layout"
    },
    {
      "type": "select",
      "id": "surface_style",
      "label": "t:apex.labels.surface_style",
      "default": "dark",
      "options": [
        { "value": "dark", "label": "t:apex.options.surface_style.dark" },
        { "value": "deep", "label": "t:apex.options.surface_style.deep" },
        { "value": "light", "label": "t:apex.options.surface_style.light" }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_grid",
      "label": "t:apex.labels.show_grid",
      "info": "t:apex.labels.show_grid_info",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:apex.labels.color_scheme",
      "default": "scheme-3"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:apex.labels.padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 88
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:apex.labels.padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 88
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "t:apex.faq.blocks.question",
      "limit": 20,
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "t:apex.faq.question",
          "default": "How long does it take?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "t:apex.faq.answer",
          "default": "<p>Most orders are engraved within 1–3 business days.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:apex.faq.name",
      "blocks": [
        { "type": "question" },
        { "type": "question" },
        { "type": "question" }
      ]
    }
  ]
}
{% endschema %}
