{%- comment -%}
  Customer review cards. Kept as editor blocks rather than pulled from a reviews
  app so the client controls exactly which quotes appear.
{%- endcomment -%}

<div
  class="apex-reviews apex-surface apex-surface--{{ section.settings.surface_style }} color-{{ section.settings.color_scheme }}"
  style="
    --apex-reviews-pad-top: {{ section.settings.padding_top }}px;
    --apex-reviews-pad-bottom: {{ section.settings.padding_bottom }}px;
    --apex-reviews-columns: {{ section.settings.columns_desktop }};
  "
>
  <span class="apex-surface__grain" aria-hidden="true"></span>
  {%- if section.settings.show_grid -%}<span class="apex-surface__grid" aria-hidden="true"></span>{%- endif -%}

  <div class="page-width">
    {%- render 'apex-section-header',
      eyebrow: section.settings.eyebrow,
      title: section.settings.title,
      subtitle: section.settings.subtitle,
      alignment: section.settings.alignment
    -%}

    {%- if section.blocks.size > 0 -%}
      <ul class="apex-reviews__grid" role="list">
        {%- for block in section.blocks -%}
          {%- assign reveal_index = forloop.index0 | modulo: 6 | plus: 1 -%}
          <li
            class="apex-review apex-reveal apex-reveal--{{ reveal_index }}{% if settings.animations_reveal_on_scroll %} scroll-trigger{% endif %}"
            {{ block.shopify_attributes }}
          >
            <span class="apex-review__mark" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="currentColor">
                <path d="M9.4 5.6c-3.1 1.5-5.1 4.3-5.1 7.9 0 3.1 1.9 5.1 4.4 5.1 2.2 0 3.9-1.6 3.9-3.7 0-2-1.4-3.5-3.3-3.5-.4 0-.8.1-1 .2.4-1.6 1.9-3.2 3.6-4.1l-2.5-1.9zm9.2 0c-3.1 1.5-5.1 4.3-5.1 7.9 0 3.1 1.9 5.1 4.4 5.1 2.2 0 3.9-1.6 3.9-3.7 0-2-1.4-3.5-3.3-3.5-.4 0-.8.1-1 .2.4-1.6 1.9-3.2 3.6-4.1l-2.5-1.9z"/>
              </svg>
            </span>

            {%- if section.settings.show_stars -%}
              <span class="apex-review__stars" aria-label="{{ 'products.reviews.rating' | t: rating: block.settings.rating }}">
                {%- for i in (1..5) -%}
                  <svg
                    class="apex-review__star{% if i > block.settings.rating %} apex-review__star--empty{% endif %}"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    aria-hidden="true"
                  >
                    <path d="m12 2.6 2.9 5.9 6.5.95-4.7 4.6 1.1 6.45L12 17.45 6.2 20.5l1.1-6.45-4.7-4.6 6.5-.95L12 2.6z"/>
                  </svg>
                {%- endfor -%}
              </span>
            {%- endif -%}

            {%- if block.settings.quote != blank -%}
              <blockquote class="apex-review__quote">{{ block.settings.quote }}</blockquote>
            {%- endif -%}

            {%- if block.settings.author != blank or block.settings.role != blank -%}
              <footer class="apex-review__author">
                {%- if block.settings.author != blank -%}
                  <p class="apex-review__name">{{ block.settings.author }}</p>
                {%- endif -%}
                {%- if block.settings.role != blank -%}
                  <p class="apex-review__role">{{ block.settings.role }}</p>
                {%- endif -%}
              </footer>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .apex-reviews {
    padding-top: var(--apex-reviews-pad-top, 80px);
    padding-bottom: var(--apex-reviews-pad-bottom, 80px);
  }

  .apex-reviews__grid {
    display: grid;
    grid-template-columns: repeat(var(--apex-reviews-columns, 3), minmax(0, 1fr));
    gap: clamp(16px, 2vw, 28px);
    margin: 0;
    padding: 0;
  }

  .apex-review {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    padding: clamp(26px, 2.8vw, 40px);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-top: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: var(--apex-radius, 5px);
    background:
      linear-gradient(165deg, rgba(255, 255, 255, 0.055) 0%, rgba(255, 255, 255, 0.012) 45%, rgba(0, 0, 0, 0.14) 100%);
    box-shadow: var(--apex-elev-1);
    transition:
      border-color 0.4s ease,
      transform 0.45s var(--apex-ease-out),
      box-shadow 0.45s var(--apex-ease-out);
  }

  .apex-surface--light .apex-review {
    border-color: rgba(0, 0, 0, 0.08);
    border-top-color: rgba(0, 0, 0, 0.06);
    background: linear-gradient(165deg, #FFFFFF 0%, #FAF9F7 100%);
  }

  .apex-review:hover {
    border-color: rgba(245, 131, 31, 0.42);
    transform: translateY(-6px);
    box-shadow: var(--apex-elev-2), var(--apex-glow-orange);
  }

  /* Oversized watermark quote mark, bled off the corner for depth. */
  .apex-review__mark {
    position: absolute;
    top: -14px;
    right: -10px;
    z-index: -1;
    display: block;
    color: var(--apex-orange);
    opacity: 0.09;
    transition: opacity 0.45s ease, transform 0.6s var(--apex-ease-out);
  }

  .apex-review__mark svg { width: 118px; height: 118px; }

  .apex-review:hover .apex-review__mark {
    opacity: 0.16;
    transform: translateY(3px) scale(1.04);
  }

  .apex-review__stars {
    display: inline-flex;
    gap: 4px;
    color: var(--apex-gold);
  }

  .apex-review__star {
    width: 17px;
    height: 17px;
    filter: drop-shadow(0 2px 6px rgba(255, 173, 0, 0.35));
  }

  .apex-review__star--empty { opacity: 0.22; filter: none; }

  .apex-review__quote {
    flex: 1;
    margin: 20px 0 0;
    padding: 0;
    border: 0;
    font-size: clamp(15px, 1.15vw, 17.5px);
    line-height: 1.75;
    font-style: normal;
    opacity: 0.9;
  }

  .apex-review__author {
    display: flex;
    flex-direction: column;
    margin-top: 26px;
    padding-top: 20px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .apex-surface--light .apex-review__author {
    border-top-color: rgba(0, 0, 0, 0.09);
  }

  .apex-review__name {
    margin: 0;
    font-family: var(--font-heading-family);
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .apex-review__role {
    margin: 4px 0 0;
    font-size: 13px;
    letter-spacing: 0.04em;
    color: var(--apex-orange);
  }

  @media screen and (max-width: 989px) {
    .apex-reviews__grid { grid-template-columns: 1fr; }
  }

  @media (prefers-reduced-motion: reduce) {
    .apex-review,
    .apex-review__mark { transition: none !important; }

    .apex-review:hover { transform: none; }
    .apex-review:hover .apex-review__mark { transform: none; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:apex.reviews.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:apex.labels.eyebrow",
      "default": "What our clients say"
    },
    {
      "type": "text",
      "id": "title",
      "label": "t:apex.labels.title",
      "default": "Customer reviews"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "t:apex.labels.subtitle"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "t:apex.labels.alignment",
      "default": "center",
      "options": [
        { "value": "left", "label": "t:apex.options.alignment.left" },
        { "value": "center", "label": "t:apex.options.alignment.center" }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_stars",
      "label": "t:apex.labels.show_stars",
      "default": true
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "t:apex.labels.columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "header",
      "content": "t:apex.reviews.header__layout"
    },
    {
      "type": "select",
      "id": "surface_style",
      "label": "t:apex.labels.surface_style",
      "default": "deep",
      "options": [
        { "value": "dark", "label": "t:apex.options.surface_style.dark" },
        { "value": "deep", "label": "t:apex.options.surface_style.deep" },
        { "value": "light", "label": "t:apex.options.surface_style.light" }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_grid",
      "label": "t:apex.labels.show_grid",
      "info": "t:apex.labels.show_grid_info",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:apex.labels.color_scheme",
      "default": "scheme-3"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:apex.labels.padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:apex.labels.padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "t:apex.reviews.blocks.review",
      "limit": 9,
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "t:apex.labels.quote",
          "default": "Knowledgeable, friendly, professional and a true master of his work. Very fair pricing for the craftsmanship you receive."
        },
        {
          "type": "range",
          "id": "rating",
          "label": "t:apex.labels.rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "text",
          "id": "author",
          "label": "t:apex.labels.author",
          "default": "Mike T."
        },
        {
          "type": "text",
          "id": "role",
          "label": "t:apex.labels.role",
          "default": "Customer"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:apex.reviews.name",
      "blocks": [
        { "type": "review", "settings": { "quote": "Joshua is a fantastic person. Knowledgeable, friendly, professional and a true master of his work. Very fair pricing for the craftsmanship you receive. Highly recommend Apex C&E!", "author": "Mike T.", "role": "Customer" } },
        { "type": "review", "settings": { "quote": "Beyond helpful and has a solid product. Excellent customer service and great business model. Thank you, Mr. Gregory!", "author": "Jake R.", "role": "Customer" } },
        { "type": "review", "settings": { "quote": "I've had custom engraving done before, but Apex is in a league of its own. Fast previews, flawless execution, quick shipping, and amazing communication. Lifetime customer earned.", "author": "Calvin L.", "role": "Police officer" } }
      ]
    }
  ]
}
{% endschema %}
