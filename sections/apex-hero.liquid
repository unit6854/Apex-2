{%- liquid
  assign heading_parts = section.settings.heading | split: '&'
  assign has_amp = false
  if heading_parts.size == 2
    assign has_amp = true
  endif

  # The headline sets on three lines — the first word alone, then the rest of
  # the phrase carrying the ampersand, then the tail. Derived from the setting
  # rather than hardcoded so a merchant editing the heading still gets the
  # break. Falls back to the two-line and single-line forms when the phrase is
  # too short to split this way.
  assign heading_lead = ''
  assign heading_rest = ''
  if has_amp
    assign head_words = heading_parts[0] | strip | split: ' '
    if head_words.size > 1
      assign heading_lead = head_words | first
      assign heading_rest = head_words | slice: 1, 20 | join: ' '
    endif
  endif

  assign stat_blocks = section.blocks | where: 'type', 'stat'
  assign link_blocks = section.blocks | where: 'type', 'quick_link'
-%}

<section
  class="apex-hero color-{{ section.settings.color_scheme }}"
  style="
    --apex-hero-min-height: {{ section.settings.min_height }}px;
    --apex-hero-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --apex-hero-fit: {{ section.settings.media_fit | default: 'cover' }};
  "
>
  <div class="apex-hero__media">
    {%- if section.settings.background_image != blank -%}
      {{
        section.settings.background_image
        | image_url: width: 3200
        | image_tag:
          class: 'apex-hero__image',
          widths: '750, 1100, 1500, 1900, 2400, 3200',
          sizes: '100vw',
          alt: '',
          preload: true,
          fetchpriority: 'high'
      }}
    {%- else -%}
      <img
        src="{{ 'hero-background-2.webp' | asset_url }}"
        class="apex-hero__image"
        alt=""
        fetchpriority="high"
        decoding="async"
        width="1756"
        height="818"
      >
    {%- endif -%}
    <div class="apex-hero__scrim" aria-hidden="true"></div>
  </div>

  <div class="apex-hero__inner">
    <div class="apex-hero__content">
      {%- if section.settings.heading != blank -%}
        <h1 class="apex-hero__heading">
          {%- if heading_lead != blank and heading_rest != blank -%}
            {{- heading_lead -}}<br>
            {{- heading_rest }} <span class="apex-hero__amp">&amp;</span><br>
            {{- heading_parts[1] | strip -}}
          {%- elsif has_amp -%}
            {{- heading_parts[0] | strip -}}
            <span class="apex-hero__amp">&amp;</span><br>
            {{- heading_parts[1] | strip -}}
          {%- else -%}
            {{- section.settings.heading -}}
          {%- endif -%}
        </h1>
      {%- endif -%}

      <span class="apex-hero__rule" aria-hidden="true"></span>

      {%- if section.settings.tagline != blank -%}
        <p class="apex-hero__tagline">{{ section.settings.tagline }}</p>
      {%- endif -%}

      {%- if section.settings.primary_label != blank or section.settings.secondary_label != blank -%}
        {%- comment -%}
          .apex-btn* is defined once in snippets/apex-variables.liquid so every
          section shares one button system. Theme Check cannot see across files.
        {%- endcomment -%}
        {% comment %}theme-check-disable ValidScopedCSSClass{% endcomment %}
        <div class="apex-hero__actions">
          {%- if section.settings.primary_label != blank -%}
            <a
              href="{{ section.settings.primary_link | default: routes.all_products_collection_url }}"
              class="apex-btn apex-btn--primary"
            >
              <span class="apex-btn__sheen" aria-hidden="true"></span>
              <span class="apex-btn__label">
                {{ section.settings.primary_label }}
                {%- comment -%}
                  Trailing arrow rather than a leading glyph: the shared
                  .apex-btn:hover rule nudges .apex-btn__icon svg along the x
                  axis, which reads as forward motion after the label and as a
                  drift away from it before.
                {%- endcomment -%}
                <span class="apex-btn__icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4 12h15"/><path d="m13 6 6 6-6 6"/>
                  </svg>
                </span>
              </span>
            </a>
          {%- endif -%}

          {%- if section.settings.secondary_label != blank -%}
            <a
              href="{{ section.settings.secondary_link | default: routes.root_url }}"
              class="apex-btn apex-btn--ghost"
            >
              <span class="apex-btn__fill" aria-hidden="true"></span>
              <span class="apex-btn__label">{{ section.settings.secondary_label }}</span>
            </a>
          {%- endif -%}
        </div>
        {% comment %}theme-check-enable ValidScopedCSSClass{% endcomment %}
      {%- endif -%}
    </div>

    {%- if stat_blocks.size > 0 -%}
      <div class="apex-hero__stats">
        {%- for block in stat_blocks -%}
          <div class="apex-stat" {{ block.shopify_attributes }}>
            <span class="apex-stat__icon" aria-hidden="true">
              {%- case block.settings.icon -%}
                {%- when 'shield' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 2 4 5.5v6c0 5 3.4 9.2 8 10.5 4.6-1.3 8-5.5 8-10.5v-6L12 2z"/>
                    <path d="m9 12 2 2 4-4"/>
                  </svg>
                {%- when 'check' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="9.2"/><path d="m8 12.3 2.7 2.7L16 9.7"/>
                  </svg>
                {%- when 'star' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m12 2.6 2.9 5.9 6.5.95-4.7 4.6 1.1 6.45L12 17.45 6.2 20.5l1.1-6.45-4.7-4.6 6.5-.95L12 2.6z"/>
                  </svg>
                {%- when 'medal' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="15" r="6.2"/><path d="m8.5 9.3-2.9-6.1h12.8l-2.9 6.1"/><path d="m12 12.4.95 1.95 2.15.3-1.55 1.5.37 2.15L12 17.3l-1.92 1-.37-2.15-1.55-1.5 2.15-.3L12 12.4z"/>
                  </svg>
                {%- when 'bolt' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M13.5 2 4 13.5h6.5L10 22l9.5-11.5H13L13.5 2z"/>
                  </svg>
                {%- else -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 2.6 4 6v6c0 5 3.3 9.2 8 10.4 4.7-1.2 8-5.4 8-10.4V6l-8-3.4z"/>
                  </svg>
              {%- endcase -%}
            </span>
            <span class="apex-stat__text">
              <span class="apex-stat__number">{{ block.settings.number }}</span>
              {{ ' ' }}
              <span class="apex-stat__label">{{ block.settings.label }}</span>
            </span>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- comment -%}
      Sits after the statistics in the DOM as well as visually. Ordering this
      with CSS alone would leave a screen reader hearing the category links
      before the credibility row that is drawn above them.
    {%- endcomment -%}
    {%- if section.settings.show_quick_links and link_blocks.size > 0 -%}
      <div class="apex-hero__shelf">
        {%- if section.settings.quick_links_title != blank -%}
          <h2 class="apex-hero__shelf-title">
            <span class="apex-hero__shelf-dash" aria-hidden="true"></span>
            {{ section.settings.quick_links_title }}
            <span class="apex-hero__shelf-dash" aria-hidden="true"></span>
          </h2>
        {%- endif -%}
        <ul class="apex-hero__pills" role="list">
          {%- for block in link_blocks -%}
            <li {{ block.shopify_attributes }}>
              <a
                href="{{ block.settings.link | default: '#' }}"
                class="apex-pill{% if block.settings.featured %} apex-pill--featured{% endif %}"
              >
                {{ block.settings.label }}
              </a>
            </li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .apex-hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    /* stretch, not center: the inner column has to span the full hero height
       for the category shelf to be able to sit against the bottom edge. */
    align-items: stretch;
    /* The hero box is locked to the photograph's own 1756x818 ratio so that
       "contain" has nothing left to letterbox: the image fills the section
       edge to edge, at full width, with none of it cropped away.

       min-height is fit-content rather than a fixed figure on purpose. The
       ratio wants height = width / 2.147, but the copy, stats and shelf need a
       roughly fixed ~640px no matter how wide the viewport is. Above ~1750px
       the ratio wins and the fit is exact. Below it the box grows to whatever
       the content needs instead of clipping it — which is the one failure the
       old fixed min-height produced (the shelf was cut off entirely). */
    aspect-ratio: 1756 / 818;
    min-height: 0;
    /* Carries the copy down until the headline's centre sits level with the
       magazine's. */
    padding: clamp(96px, 8vw, 120px) 0 clamp(30px, 3.4vw, 46px);
    background-color: #0a0908;
  }

  .apex-hero__media,
  .apex-hero__scrim {
    position: absolute;
    inset: 0;
  }

  .apex-hero__media {
    z-index: -1;
  }

  /* "cover" fills the bleed edge-to-edge. "contain" is only right when the
     photograph has to be seen in full, and it letterboxes against the section
     background, which reads as a border around the hero.

     Centred because the section is now locked to the photograph's own ratio,
     so there is nothing to crop and no edge to favour. The variable stays so
     an anchor can be set per-section if a future image needs one. */
  .apex-hero__image {
    width: 100%;
    height: 100%;
    object-fit: var(--apex-hero-fit, cover);
    object-position: var(--apex-hero-position, center center);
    display: block;
  }

  /* A wedge of shade under the copy that runs out before it reaches the
     products. Cropping the photograph left the text sitting over lit smoke
     rather than dead space, so the type needs its own ground.

     Held near full strength across the copy column, then released quickly —
     roughly 0.79 alpha at the left edge down to 0.25 by 78%, so the magazine
     and knife stay at full brightness. The vertical pass is much lighter than
     before for the same reason: it used to close at 0.75 on a letterboxed
     frame, which now would dim the product bases. */
  .apex-hero__scrim {
    background:
      linear-gradient(
        90deg,
        rgba(0, 0, 0, calc(var(--apex-hero-overlay, 0.9) * 0.9)) 0%,
        rgba(0, 0, 0, calc(var(--apex-hero-overlay, 0.9) * 0.86)) 38%,
        rgba(0, 0, 0, calc(var(--apex-hero-overlay, 0.9) * 0.66)) 56%,
        rgba(0, 0, 0, calc(var(--apex-hero-overlay, 0.9) * 0.3)) 78%,
        rgba(0, 0, 0, calc(var(--apex-hero-overlay, 0.9) * 0.14)) 100%
      ),
      linear-gradient(180deg, rgba(10, 9, 8, 0.42) 0%, rgba(10, 9, 8, 0) 26%, rgba(10, 9, 8, 0.5) 100%);
  }

  .apex-hero__inner {
    display: flex;
    flex-direction: column;
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 clamp(20px, 4vw, 50px);
  }

  /* Narrowed from 780px so the photography carries more of the frame and the
     products read as the focal point. The cap keeps the measure sane on very
     wide screens, where a straight 40% would stretch the paragraph past a
     comfortable line length. */
  /* The percentage resolves against .apex-hero__inner, which is capped at
     1400px and padded, not against the hero's full width — so 43% here lands at
     roughly 38-39% of the hero at common desktop sizes. The px cap holds the
     measure steady on wider screens. */
  .apex-hero__content {
    max-width: min(48%, 620px);
  }

  .apex-hero__heading {
    margin: 0;
    font-family: var(--font-heading-family);
    font-weight: 800;
    /* Stepped down ~9% from the previous 72px ceiling. At the old size the
       three lines dominated the frame and crowded the navigation. */
    font-size: clamp(30px, 4.55vw, 65px);
    /* Opened up again, from 0.92 to 1.02 to 1.09. */
    line-height: 1.09;
    letter-spacing: -0.005em;
    text-transform: uppercase;
    color: #fff;
    /* No text-wrap: balance — the line breaks are authored with <br>, and
       balancing would fight them. */
  }

  .apex-hero__amp {
    color: var(--apex-orange);
    padding-left: 0.08em;
  }

  .apex-hero__rule {
    display: block;
    width: 72px;
    height: 3px;
    /* The largest gap in the hero. Spacing tightens on every step down from
       here, which is what gives the column its direction of travel. */
    margin: clamp(32px, 3.5vw, 48px) 0 clamp(28px, 3.1vw, 42px);
    background: var(--apex-gradient);
    transform-origin: left center;
    animation: apex-rule-in 0.8s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  @keyframes apex-rule-in {
    from { transform: scaleX(0); }
    to   { transform: scaleX(1); }
  }

  .apex-hero__tagline {
    margin: 0;
    /* 600px, so the sentence breaks about three words later per line and stops
       shredding into a narrow stack. */
    max-width: 600px;
    font-size: clamp(15px, 1.2vw, 18px);
    line-height: 1.9;
    color: rgba(255, 255, 255, 0.8);
  }

  /* Second-largest step. */
  .apex-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(22px, 2.6vw, 38px);
    margin-top: clamp(40px, 4.2vw, 58px);
  }

  /* Taller and wider than the shared 60px default. These are the hero's
     primary conversion targets, and the extra mass reads as deliberate rather
     than as a component reused at its default size. */
  .apex-hero__actions .apex-btn {
    min-height: 72px;
    padding: 0 clamp(32px, 3.2vw, 50px);
  }

  /* ---------- Trust indicators ---------- */

  /* Was a bordered, blurred panel. Stripped back to a bare row: the credibility
     line should register on the way past the headline, not compete with the
     buttons directly above it for weight. Separation now comes from hairline
     dividers and spacing alone.

     Wider than the 40% content column so all three sit on one line without the
     labels wrapping. */
  /* Grid rather than flex so the three columns are exactly equal and the
     dividers land on a regular beat — with flex each item sized to its own
     label and the rules sat at arbitrary intervals. */
  /* auto columns rather than three equal fractions: set on one line each, the
     three phrases differ in length, and forcing equal columns opened ragged
     gaps before each divider. Sized to content with a fixed gutter, the rules
     now sit a consistent distance from the text on both sides. */
  .apex-hero__stats {
    display: flex;
    /* One line, always. The three phrases measure ~679px and the old 52% cap
       resolved to 676px, so "Satisfaction guaranteed" wrapped to a second row
       three pixels short. The cap is raised just enough to seat all three and
       wrapping is off so a label edit cannot silently drop one to row two. */
    flex-wrap: nowrap;
    align-items: center;
    width: auto;
    /* Still bounded so the row cannot creep under the magazine. */
    max-width: min(62%, 780px);
    margin-top: clamp(10px, 3.2vw, 24px);
    border: 0;
    border-radius: 0;
    background: none;
    backdrop-filter: none;
  }

  .apex-stat {
    display: flex;
    align-items: center;
    gap: clamp(9px, 1vw, 12px);
    padding: 2px clamp(12px, 1.5vw, 20px);
  }

  .apex-stat:first-child { padding-left: 0; }

  .apex-stat + .apex-stat {
    border-left: 1px solid rgba(255, 255, 255, 0.12);
  }

  /* Fixed box so the glyphs share one optical centre — the shield, circle and
     star have different natural heights and were sitting at slightly different
     baselines against their labels. */
  .apex-stat__icon {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    width: clamp(17px, 1.35vw, 20px);
    height: clamp(17px, 1.35vw, 20px);
  }

  .apex-stat__icon svg {
    display: block;
    width: 100%;
    height: 100%;
    color: rgba(245, 131, 31, 0.9);
    transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .apex-stat:hover .apex-stat__icon svg { transform: scale(1.12); }

  /* One line each: figure and label set as a single phrase rather than stacked,
     which is what drops this row from a featured block to a caption. */
  .apex-stat__text {
    display: flex;
    align-items: baseline;
    gap: 0.4em;
    white-space: nowrap;
  }

  /* White rather than orange. With the panel gone the orange sat on the
     background unmediated and pulled focus off the buttons; the icons carry the
     accent instead. */
  /* Dialled back again. This row is supporting evidence, not a headline act —
     it should register on the way past rather than hold the eye. */
  .apex-stat__number {
    font-family: var(--font-heading-family);
    font-size: clamp(13px, 1.05vw, 15px);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: 0.02em;
    color: rgba(255, 255, 255, 0.9);
  }

  .apex-stat__label {
    margin-top: 0;
    font-size: clamp(9px, 0.7vw, 11px);
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.5);
  }

  /* ---------- Best-seller shelf ---------- */

  /* margin-top: auto is gone. Absorbing the leftover height pinned the shelf to
     the floor but opened the dead band above it — the hero split into copy, a
     void, and a detached strip. Following directly on a short gap instead, the
     categories close the composition rather than forming a third band.
     Roughly a 70% cut on the gap that was there. */
  .apex-hero__shelf {
    padding-top: clamp(20px, 2.1vw, 26px);
    text-align: center;
  }

  .apex-hero__shelf-title {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(16px, 2vw, 30px);
    margin: 0 0 clamp(18px, 2.1vw, 26px);
    font-family: var(--font-heading-family);
    font-size: clamp(11px, 0.86vw, 13px);
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.72);
  }

  /* Hairline rules that run out from the heading and fade before the edge, so
     the row is framed without drawing a hard line across the photograph. */
  .apex-hero__shelf-dash {
    flex: 1 1 0;
    max-width: 340px;
    width: auto;
    height: 1px;
    background: linear-gradient(90deg, rgba(255, 173, 0, 0) 0%, rgba(255, 173, 0, 0.55) 100%);
  }

  .apex-hero__shelf-dash:last-child {
    background: linear-gradient(90deg, rgba(255, 173, 0, 0.55) 0%, rgba(255, 173, 0, 0) 100%);
  }

  /* Grid rather than flex so every category is the same width regardless of
     label length — "Zippos" and "Cerakote services" otherwise size to their
     text and the row loses its rhythm. */
  .apex-hero__pills {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: clamp(12px, 1.4vw, 20px);
    max-width: 1000px;
    margin: 0 auto;
    padding: 0;
  }

  .apex-hero__pills li { display: flex; }

  .apex-pill {
    position: relative;
    isolation: isolate;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 48px;
    padding: 0 clamp(14px, 1.6vw, 22px);
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 4px;
    background: rgba(10, 9, 8, 0.3);
    font-family: var(--font-heading-family);
    font-size: clamp(11px, 0.85vw, 13px);
    font-weight: 700;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    text-decoration: none;
    color: #fff;
    overflow: hidden;
    transition:
      border-color 0.3s ease,
      color 0.3s ease,
      transform 0.3s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.3s ease;
  }

  .apex-pill::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: rgba(245, 131, 31, 0.14);
    transform: translateY(101%);
    transition: transform 0.36s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .apex-pill:hover {
    border-color: var(--apex-orange);
    color: var(--apex-gold);
    transform: translateY(-3px);
    box-shadow: 0 10px 24px rgba(245, 131, 31, 0.22);
  }

  .apex-pill:hover::before { transform: translateY(0); }
  .apex-pill:active { transform: translateY(0) scale(0.985); transition-duration: 0.09s; }

  .apex-pill:focus-visible { outline: 2px solid var(--apex-gold); outline-offset: 3px; }

  .apex-pill--featured {
    border-color: var(--apex-orange);
    color: var(--apex-orange);
  }

  /* ---------- Responsive ---------- */

  @media screen and (max-width: 989px) {
    .apex-hero {
      min-height: 0;
      padding: 56px 0 48px;
    }

    .apex-hero__image { object-position: center center; }

    .apex-hero__scrim {
      background:
        linear-gradient(180deg, rgba(10, 9, 8, 0.9) 0%, rgba(10, 9, 8, 0.72) 45%, rgba(10, 9, 8, 0.94) 100%);
    }

    /* The 40% column and the matching stats width are desktop-only. Below the
       split layout the photograph is behind the text rather than beside it, so
       the content takes the full measure again. */
    .apex-hero__content { max-width: 100%; }

    .apex-hero__stats {
      width: 100%;
      max-width: 100%;
      row-gap: 18px;
    }
  }

  @media screen and (max-width: 749px) {
    .apex-hero__actions { gap: 12px; }
    .apex-hero__actions .apex-btn { flex: 1 1 100%; }

    /* Stack the credibility row and drop the vertical dividers — at this width
       three columns leave about 110px each and the labels wrap mid-phrase.
       Overriding grid-template-columns, not flex-direction: this row is a grid
       now, and a flex property here would silently do nothing. */
    /* flex-direction, matching the flex container above. This override has to
       be kept in step with the display type — it has now been wrong in both
       directions, once as flex-direction against a grid and once as
       grid-template-columns against a flex. */
    .apex-hero__stats {
      flex-direction: column;
      align-items: flex-start;
      row-gap: 14px;
    }
    .apex-stat { padding: 0; }
    .apex-stat + .apex-stat { border-left: 0; }

    .apex-hero__pills { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .apex-hero__shelf-dash { max-width: 60px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .apex-pill,
    .apex-pill::before,
    .apex-stat__icon svg,
    .apex-hero__rule {
      transition: none !important;
      animation: none !important;
    }

    .apex-pill:hover { transform: none; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:apex.hero.name",
  "tag": "section",
  "class": "apex-hero-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "t:apex.labels.background_image",
      "info": "t:apex.hero.background_info"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "t:apex.labels.overlay_opacity",
      "min": 40,
      "max": 100,
      "step": 2,
      "unit": "%",
      "default": 90
    },
    {
      "type": "range",
      "id": "min_height",
      "label": "t:apex.labels.min_height",
      "min": 260,
      "max": 900,
      "step": 20,
      "unit": "px",
      "default": 420
    },
    {
      "type": "select",
      "id": "media_fit",
      "label": "t:apex.labels.media_fit",
      "info": "t:apex.hero.media_fit_info",
      "default": "cover",
      "options": [
        { "value": "cover", "label": "t:apex.options.media_fit.cover" },
        { "value": "contain", "label": "t:apex.options.media_fit.contain" }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:apex.labels.color_scheme",
      "default": "scheme-3"
    },
    {
      "type": "header",
      "content": "t:apex.hero.header__content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:apex.labels.heading",
      "info": "t:apex.hero.heading_info",
      "default": "Custom coatings & engraving"
    },
    {
      "type": "textarea",
      "id": "tagline",
      "label": "t:apex.labels.tagline",
      "default": "Precision, laser engraving, Cerakote application, and guaranteed quality. Craftsmanship you can trust & products that last."
    },
    {
      "type": "header",
      "content": "t:apex.hero.header__buttons"
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "t:apex.labels.primary_label",
      "default": "Browse products"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "t:apex.labels.primary_link"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "t:apex.labels.secondary_label",
      "default": "Request a quote"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "t:apex.labels.secondary_link"
    },
    {
      "type": "header",
      "content": "t:apex.hero.header__shelf"
    },
    {
      "type": "checkbox",
      "id": "show_quick_links",
      "label": "t:apex.labels.show_quick_links",
      "default": true
    },
    {
      "type": "text",
      "id": "quick_links_title",
      "label": "t:apex.labels.quick_links_title",
      "default": "Shop our best sellers"
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "t:apex.hero.blocks.stat",
      "limit": 4,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "t:apex.labels.icon",
          "default": "shield",
          "options": [
            { "value": "shield", "label": "t:apex.options.icon.shield" },
            { "value": "check", "label": "t:apex.options.icon.check" },
            { "value": "star", "label": "t:apex.options.icon.star" },
            { "value": "medal", "label": "t:apex.options.icon.medal" },
            { "value": "bolt", "label": "t:apex.options.icon.bolt" }
          ]
        },
        {
          "type": "text",
          "id": "number",
          "label": "t:apex.labels.stat_number",
          "default": "15+"
        },
        {
          "type": "text",
          "id": "label",
          "label": "t:apex.labels.stat_label",
          "default": "Years experience"
        }
      ]
    },
    {
      "type": "quick_link",
      "name": "t:apex.hero.blocks.quick_link",
      "limit": 6,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "t:apex.labels.label",
          "default": "PMAGs"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:apex.labels.link"
        },
        {
          "type": "checkbox",
          "id": "featured",
          "label": "t:apex.labels.featured",
          "info": "t:apex.labels.featured_info",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:apex.hero.name",
      "blocks": [
        { "type": "stat", "settings": { "icon": "shield", "number": "15+",  "label": "Years experience" } },
        { "type": "stat", "settings": { "icon": "check",  "number": "2K+",  "label": "Jobs completed" } },
        { "type": "stat", "settings": { "icon": "star",   "number": "100%", "label": "Satisfaction" } },
        { "type": "quick_link", "settings": { "label": "PMAGs", "featured": true } },
        { "type": "quick_link", "settings": { "label": "Zippos" } },
        { "type": "quick_link", "settings": { "label": "1911 grips" } },
        { "type": "quick_link", "settings": { "label": "Cerakote services" } }
      ]
    }
  ]
}
{% endschema %}
